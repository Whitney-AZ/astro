---
import Layout from '@/layouts/Layout.astro'
import { Flashlight } from '@/components/Flashlight'

// 1. 导入你的 Highlight 组件
import Highlight from '@/components/Highlight.astro' 
---

<div class="full-screen-bg-container">
  <Layout title="404">
    <div class="center-content">
      <div class="max-w-[800px] mx-auto py-16 px-4 md:px-8 text-center">
        <a class="text-accent text-xl md:text-2xl inline-flex text-red-600 dark:text-red-400" href="/">
          <span class="ml-2">哎呀，<Highlight>404</Highlight>啦！</span>
        </a>
      </div>
    </div>
    
    <Flashlight client:only="react" />
  </Layout>
</div>

<style is:global>
  /* 容器样式：用于设置背景和 Flex 布局的父级 */
  .full-screen-bg-container {
    min-height: 100vh; 
    width: 100%;
    display: flex; 
    
    /* 假设你的背景图放在 public/404-bg.jpg */
    background-image: url('/src/assets/404-bg.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }
  
  /* 内容样式：用于实现垂直居中 */
  .center-content {
    margin: auto; 
    align-self: center; 
  }

  /* 基础清理样式 */
  html, body {
      background-color: transparent; 
  }
</style>