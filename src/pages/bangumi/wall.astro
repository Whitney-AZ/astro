---
import PageLayout from '@/layouts/PageLayout.astro'
import BangumiWall from '@/components/BangumiWall'
import config from '@/config.json'
import { fetchPublicCollections, type WallItem } from '@/lib/bangumi-wall'
import '@/styles/bangumi-preview.css'
import '@/styles/bangumi-wall.css'

const username = config.bangumi.username
let items: WallItem[] = []
let syncedAt: string | null = null
let syncFailed = false
try {
  items = await fetchPublicCollections(username)
  syncedAt = new Date().toISOString()
} catch (error) {
  syncFailed = true
  console.warn('[Bangumi wall] Public collections unavailable:', String(error))
}
---

<PageLayout
  title="收藏封面墙 · Bangumi"
  description="我的 Bangumi 收藏：动画、书籍、游戏、音乐与三次元。"
>
  <div class="bangumi-journal">
    <BangumiWall
      client:load
      username={username}
      initialItems={items}
      syncedAt={syncedAt}
      syncFailed={syncFailed}
    />
    <noscript
      ><p class="bangumi-sync-note">
        当前展示最近同步的收藏。启用 JavaScript 后可筛选、搜索和切换视图。
      </p></noscript
    >
  </div>
</PageLayout>
