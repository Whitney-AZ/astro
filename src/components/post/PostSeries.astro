---
import type { CollectionEntry } from 'astro:content'

interface Props {
  seriesPosts: CollectionEntry<'posts'>[]
  currentSlug: string
  seriesName: string
}

const { seriesPosts, currentSlug, seriesName } = Astro.props

const isSrednicki = seriesName === 'Srednicki QFT'
const sortedPosts = [...seriesPosts].sort((a, b) => {
  if (isSrednicki) {
    return (a.data.srednickiSections[0] ?? 98) - (b.data.srednickiSections[0] ?? 98)
  }
  return a.data.date.valueOf() - b.data.date.valueOf()
})
---

<div class="mb-8 p-4 rounded-lg bg-accent/10 border border-accent/20">
  <details open={!isSrednicki || sortedPosts.length <= 12}>
  <summary class="font-bold text-accent cursor-pointer">
    系列文章：{seriesName}
    {isSrednicki && <span class="ml-2 text-sm font-normal">共 {sortedPosts.length} 篇</span>}
  </summary>
  <ul class="space-y-2">
    {sortedPosts.map((post, index) => (
      <li class="flex items-center gap-2 text-sm">
        <span class="text-secondary">{index + 1}.</span>
        {post.slug === currentSlug ? (
          <span class="font-semibold text-primary">{post.data.title} (当前文章)</span>
        ) : (
          <a href={`/posts/${post.slug}`} class="hover:text-accent hover:underline underline-offset-2">
            {post.data.title}
          </a>
        )}
      </li>
    ))}
  </ul>
  </details>
</div>
