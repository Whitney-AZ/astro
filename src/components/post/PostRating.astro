---
interface Props {
  rating: number;
  maxRating?: number;
}

const { rating, maxRating = 10 } = Astro.props;

const fullStars = Math.floor(rating);
const decimalPart = (rating) % 1 - 0.1;
const hasPartialStar = decimalPart > 0.01;
const emptyStars = maxRating - fullStars - (hasPartialStar ? 1 : 0);

const gradientId = `rating-clip-${Math.random().toString(36).substr(2, 9)}`;
const partialPercentage = Math.round(decimalPart * 100);

const starIconClass = "w-5 h-5";
const starColorClass = "text-amber-400"; // 星星的颜色
---

<div class="flex items-center gap-1" title={`评分: ${rating} / ${maxRating}`}>
  {/* 渲染实心星 */}
  {Array(fullStars).fill(0).map(() => (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class:list={[starIconClass, starColorClass]}>
      <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
    </svg>
  ))}

  {/* 渲染部分填充的星星 */}
  {hasPartialStar && (
    <div class="relative" class:list={[starIconClass]}>
      {/* 底层：带描边的空心星 */}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class:list={[starIconClass, starColorClass, "absolute"]}>
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
      </svg>

      {/* 顶层：被裁切的实心星 */}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class:list={[starIconClass, starColorClass, "absolute"]} style={`clip-path: url(#${gradientId});`}>
        <defs>
          <clipPath id={gradientId}>
            <rect x="0" y="0" width={`${partialPercentage}%`} height="100%" />
          </clipPath>
        </defs>
        <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
      </svg>
    </div>
  )}

  {/* 渲染空心星 */}
  {Array(emptyStars).fill(0).map(() => (
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class:list={[starIconClass, "text-amber-400/50"]}>
      <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
    </svg>
  ))}
</div>