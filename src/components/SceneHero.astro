---
import {hero, site} from '@/config.json'
---
<section class="scene-hero" aria-labelledby="hero-title">
 <a href="/background.webp" target="_blank" rel="noreferrer" class="scene-art scene-art-light" aria-label="查看莲之空六人原图"><img src="/background.webp" alt="莲之空六个人的首页插画" width="3720" height="2634" fetchpriority="high" loading="eager"/><span class="scene-image-label">查看原图 ↗</span></a>
 <a href="/background-dark.webp" target="_blank" rel="noreferrer" class="scene-art scene-art-dark" aria-label="查看暗色主题原图"><img src="/background-dark.webp" alt="原项目的暗色主题极光背景" width="1920" height="1080" loading="eager"/><span class="scene-image-label">查看原图 ↗</span></a>
 <div class="scene-content"><div class="scene-copy"><div class="scene-hello"><span>✦</span> {site.description}</div><h1 id="hero-title">Phy<span>MAnime</span><i>.</i></h1><p class="scene-bio">{hero.bio}</p><p class="scene-description">{hero.description}</p><div class="scene-actions"><a class="scene-primary" href="#entries">开始阅读 <span>↓</span></a><a class="scene-secondary" href="/about">关于我 <span>↗</span></a></div></div><div class="scene-socials">{hero.socials.map(s=><a href={s.url} target={s.url.startsWith('mailto:')?undefined:'_blank'} rel="noreferrer" aria-label={s.name}><i class={`iconfont ${s.icon}`} aria-hidden="true"/></a>)}</div></div>
</section>
